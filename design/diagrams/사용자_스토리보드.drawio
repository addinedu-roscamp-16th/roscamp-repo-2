        <mxCell id="ub0_tl80" value="10:12  접수됨" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=9;align=left;spacingLeft=4;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
