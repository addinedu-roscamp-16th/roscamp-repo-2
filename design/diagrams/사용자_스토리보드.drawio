        <mxCell id="ub0_c44" value="역할 = 사용자 → 이 화면 / 관리자 → 관리자 화면" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="700" y="328" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="desc2" value="고객: 아이디 · 비밀번호로 로그인&lt;br&gt;시스템: 역할이 사용자면 이 주문 화면으로, 관리자면 관리자 화면으로 보냄&lt;br&gt;근거: SCR-01 로그인 · 역할 구분 · OMS-01" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingTop=4;fontColor=#222222;fillColor=#f5f5f5;strokeColor=#dddddd;" vertex="1" parent="1">
