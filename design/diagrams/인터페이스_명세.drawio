        <mxCell id="if-msg_103" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" value="그 밖의 타입 (SubmitTrip · CancelOrder · SetAssignHold · GetCloseState · Hello · CheckStock · ForceInput · SetMode · ConfirmClear · Reinstate)은 2-1 ~ 2-3 탭과 본문 정의 참고" vertex="1"><mxGeometry x="1200" y="1240" width="640" height="44" as="geometry" /></mxCell>
