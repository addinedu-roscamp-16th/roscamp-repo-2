        <mxCell id="sb5_c55" value="① 강제 출고 처리" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#1f5fbf;strokeWidth=2;fontSize=9;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
