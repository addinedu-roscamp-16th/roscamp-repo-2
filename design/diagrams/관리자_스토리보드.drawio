        <mxCell id="sb3_note110" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" value="&lt;b&gt;판단&lt;/b&gt;&lt;br&gt;담는 중 · 담기 일시 중지에는 Pode 장애로 주문을 판단하지 않습니다. 주문이 운반 중으로 바뀐 뒤 판단합니다.&lt;br&gt;장애 Pode는 관리자가 로봇 화면에서 락을 풀고 손으로 옮깁니다. 새 Pode 대체 배정은 구현하지 않습니다.&lt;br&gt;손으로 옮긴 Pode는 위치를 모르므로 자기 대기 장소에 두고 운행 복귀 확인 때 위치를 다시 설정합니다 (비상정지 P-10과 같음)." vertex="1">
          <mxGeometry height="121" width="540" x="40" y="1498" as="geometry" />
        </mxCell>
        <mxCell id="sb3_note111" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" value="&lt;b&gt;결정 필요&lt;/b&gt;&lt;br&gt;D-06 관리자 알림 방식 (장면 1 · 2 · 3)&lt;br&gt;운행 복귀 확인 뒤 복귀 시점을 6-7과 맞춤 (다이어그램 수정 요청 R-04)" vertex="1">
          <mxGeometry height="61" width="540" x="600" y="1498" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
