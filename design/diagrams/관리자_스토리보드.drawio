        <mxCell id="sb4_note98" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" value="&lt;b&gt;판단&lt;/b&gt;&lt;br&gt;한 팔이라도 장애면 서비스 일시 정지(MODE_PAUSE). 수리 후 이어서 담기는 하지 않습니다.&lt;br&gt;담는 중이 아닌 주문(배정됨 · 운반 중)은 그대로 두고 재시작 뒤 이어서 처리합니다.&lt;br&gt;재시작 버튼은 위쪽 고정 줄에만 있고, 장애 처리 완료 전에는 꺼져 있습니다." vertex="1">
          <mxGeometry height="76" width="540" x="40" y="1498" as="geometry" />
        </mxCell>
        <mxCell id="sb4_note99" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" value="&lt;b&gt;결정 필요&lt;/b&gt;&lt;br&gt;D-06 관리자 알림 방식 (장면 1 · 3)&lt;br&gt;담기 일시 중지 중인 주문에 Phody 장애가 나는 경우 (2. 주문에 전이 없음, 다이어그램 수정 요청 R-06)&lt;br&gt;버튼 순서 조건: 일부 출고 강제 처리(#13) 전에는 [재시작]을 끔 (R-10)" vertex="1">
          <mxGeometry height="91" width="540" x="600" y="1498" as="geometry" />
        </mxCell>
        <mxCell id="sb4_note100" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" value="&lt;b&gt;간편 처리&lt;/b&gt;&lt;br&gt;장면 6의 패널은 장면 2 · 3 · 4를 한 패널에서 하는 길입니다. 주문 관리 · 로봇 화면에서 해도 같은 조치입니다." vertex="1">
          <mxGeometry height="61" width="540" x="1160" y="1498" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
