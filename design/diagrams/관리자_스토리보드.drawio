        <mxCell id="sb5_c54" value="▶ 1. 손으로 교환 · Phony 정리 뒤" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontSize=9;align=left;spacingLeft=4;whiteSpace=wrap;fontColor=#5c4700;" vertex="1" parent="1">
