        </mxCell>
        <mxCell id="sb5_c56" value="○ 2. 1번 뒤 켜짐" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#dddddd;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="298" y="696" width="262" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sb5_c57" value="운행 복귀 확인" style="rounded=1;html=1;fillColor=#eeeeee;strokeColor=#bbbbbb;fontColor=#999999;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="473" y="717" width="80" height="16" as="geometry" />
        </mxCell>
        <mxCell id="desc4" value="관리자: 알림의 [간편 처리] → 손으로 교환한 뒤 ①[강제 출고 처리] → 확인 창에서 [확인] → 같은 패널의 [운행 복귀 확인]&lt;br&gt;시스템: #1025 출고됨 · 일부 출고됨. 그다음 운행 복귀 확인이 켜짐 (상품을 실은 채 복귀하지 않도록 순서를 지킴)&lt;br&gt;근거: SCR-21 · SCR-11 · 6-7 #9 · #12" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=8;spacingTop=4;fontColor=#222222;fillColor=#f5f5f5;strokeColor=#dddddd;" vertex="1" parent="1">
          <mxGeometry x="50" y="847" width="520" height="91" as="geometry" />
        </mxCell>
        <mxCell id="sb5_e58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="sc1" target="sc2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sb5_e59" value="[간편 처리]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sc1" target="sc4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sb5_e60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" edge="1" parent="1" source="sc2" target="sc3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sb5_note61" value="&lt;b&gt;판단&lt;/b&gt;&lt;br&gt;Phony 장애는 재시도 없이 바로 오류입니다. 관리자가 손으로 정리합니다.&lt;br&gt;간편 처리 패널(장면 4)은 장면 2 · 3을 한 패널에서 하는 길입니다. 각 화면에서 해도 같습니다.&lt;br&gt;출고 구역 배정 중지는 구현하지 않습니다. 뒤따르는 Pode는 출고 구역 앞에서 이동 중 대기합니다." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1022" width="540" height="106" as="geometry" />
        </mxCell>
        <mxCell id="sb5_note62" value="&lt;b&gt;결정 필요&lt;/b&gt;&lt;br&gt;D-06 관리자 알림 방식 (장면 1 · 3)&lt;br&gt;Phony 장애 때 주문을 주문 처리 보류(HELD)로 둘지 (2. 주문에는 운반 중 → 출고됨 강제 출고 경로가 없음, 다이어그램 수정 요청 R-07)" style="shape=note;size=14;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="600" y="1022" width="540" height="76" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
