        <mxCell id="sb1_c1" value="1. 평상시 현황 — 로그인부터 주문 출고까지 지켜보기" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1400" height="36" as="geometry" />
