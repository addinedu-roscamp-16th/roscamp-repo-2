        <mxCell id="sb7_e135" edge="1" parent="1" source="sc5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" target="sc6" value="">
          <mxGeometry relative="1" as="geometry" />
