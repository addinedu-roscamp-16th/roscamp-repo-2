        <mxCell id="sb9_note130" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" value="&lt;b&gt;참고&lt;/b&gt;&lt;br&gt;마감 중에는 로봇이 멈추지 않고 배정만 멈춥니다 (서비스 일시 정지와 다름). 위쪽 작업 상태에 &quot;· 마감&quot;을 붙입니다.&lt;br&gt;막는 기록: 반출 · 수시 조정은 마감 시작부터, 입고는 실사를 연 뒤부터. 출고 차감은 계속 받습니다.&lt;br&gt;남은 운반 건이 모두 끝난 뒤 세므로, 바구니에 든 상품 때문에 생기는 가짜 차이가 없습니다.&lt;br&gt;마감에는 시간 제한이 없습니다. 끝내려면 [마감 취소]." vertex="1">
          <mxGeometry height="121" width="540" x="40" y="1483" as="geometry" />
        </mxCell>
        <mxCell id="sb9_note131" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" value="&lt;b&gt;미결&lt;/b&gt;&lt;br&gt;마감 주기와 운영 종료에 엮을지 (지금은 관리자가 원할 때 누름)&lt;br&gt;서비스 일시 정지 · 비상정지 중에는 남은 운반 건이 끝나지 않으므로 마감이 기다리기만 함 (재시작 뒤 이어서)&lt;br&gt;차이 사유 목록 값은 팀 확인&lt;br&gt;주문 처리와 배정 보류 · 재개를 주고받는 인터페이스 정의 예정 (R-08 · R-17)&lt;br&gt;D-06 관리자 알림 방식 (장면 7의 거절 알림)" vertex="1">
          <mxGeometry height="121" width="540" x="600" y="1483" as="geometry" />
        </mxCell>
      </root>
