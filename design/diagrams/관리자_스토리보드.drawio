        <mxCell id="sb7_e133" edge="1" parent="1" source="sc1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;" target="sc2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sb7_e134" edge="1" parent="1" source="sc3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="sc4" value="기록 확인">
