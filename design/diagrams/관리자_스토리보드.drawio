        </mxCell>
        <mxCell id="sc1" value="장면 1 · 로그인" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="540" height="361" as="geometry" />
        </mxCell>
        <mxCell id="sb1_c3" value="" style="rounded=0;html=1;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="50" y="128" width="520" height="250" as="geometry" />
        </mxCell>
        <mxCell id="sb1_c4" value="&lt;b&gt;IFP 로그인&lt;/b&gt;&lt;br&gt;&lt;br&gt;아이디 [__________]&lt;br&gt;비밀번호 [__________]" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;fontSize=9;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="210" y="178" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sb1_c5" value="① 로그인" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#1f5fbf;strokeWidth=2;fontSize=9;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
