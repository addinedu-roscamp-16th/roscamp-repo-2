        </mxCell>
        <mxCell id="sb1_note56" value="&lt;b&gt;미결&lt;/b&gt;&lt;br&gt;지도 · Pode 위치(SCR-06)는 일정에 따라 결정합니다." style="shape=note;size=14;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="600" y="977" width="540" height="46" as="geometry" />
        </mxCell>
      </root>
