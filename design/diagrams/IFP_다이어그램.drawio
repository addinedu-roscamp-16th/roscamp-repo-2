        </mxCell>
        <mxCell id="v22_ship_e_end" edge="1" parent="1" source="ship_idle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.088;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="v22_ship_end" value="운행 종료&lt;br&gt;(관리자 운행 중지 · 전원 끔)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ship_n_force" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" value="&lt;b&gt;시험 모드 강제 입력 경로 (SCR-17, &#39;6-10&#39;)&lt;/b&gt;&lt;br&gt;상태 바꾸기: 오류(ERROR)와 원인 → 실제로 멈추고 보고. 조건 바꾸기는 원래 규칙대로 동작 (남은 빈 바구니 수는 빈 바구니 부족 처리(6-3)를 구현할 때 더함)&lt;br&gt;시험 모드일 때만 받음. 강제 해제 뒤 복귀는 관리자 운행 복귀 확인 (보통 절차)" vertex="1">
          <mxGeometry height="78" width="560" x="60" y="16" as="geometry" />
        </mxCell>
              <mxCell id="ship_es_reg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffafa;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;" value="비상정지 (COM-02, &#x27;6-11&#x27;, 11-24) — 모든 상태에 적용" vertex="1">
          <mxGeometry height="200" width="1120" x="60" y="130" as="geometry" />
        </mxCell>
        <mxCell id="ship_es_any" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" value="모든 상태&lt;br&gt;(동작 중 · 오류)" vertex="1">
          <mxGeometry height="70" width="190" x="80" y="200" as="geometry" />
        </mxCell>
        <mxCell id="ship_es_es" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="&lt;b&gt;비상정지 (ESTOP)&lt;/b&gt;&lt;br&gt;entry / 동작 멈춤, 서보 힘 유지 (그 자세)&lt;br&gt;해제 신호까지 스스로 유지&lt;br&gt;락 해제 (estop 노드) / 서보 힘 풂 (바구니 · 팔을 받친 뒤)&lt;br&gt;락 잠금 (estop 노드) / 서보 힘 걺" vertex="1">
          <mxGeometry height="140" width="390" x="430" y="166" as="geometry" />
        </mxCell>
        <mxCell id="ship_es_idle" parent="1" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="대기 (IDLE)" vertex="1">
          <mxGeometry height="60" width="180" x="970" y="205" as="geometry" />
        </mxCell>
        <mxCell id="ship_es_t1" edge="1" parent="1" source="ship_es_any" target="ship_es_es" style="html=1;endArrow=open;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;" value="/safety/estop: 정지&lt;br&gt;(P-02 · P-06)">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="ship_es_t2" edge="1" parent="1" source="ship_es_es" target="ship_es_idle" style="html=1;endArrow=open;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;" value="/safety/estop: 해제 [락 잠김]&lt;br&gt;/ 안전 자세에서 시작">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="ship_es_n" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" value="&lt;b&gt;비상정지 (P-01 ~ P-14, &#x27;6-11&#x27;)&lt;/b&gt;&lt;br&gt;관리자 화면 · 태블릿에서 누르면 estop 노드가 /safety/estop을 보냅니다. 모든 로봇이 멈추고 1초 안에 ESTOP을 보고합니다 (P-04).&lt;br&gt;ESTOP은 서비스 일시 정지(PAUSE)와 다릅니다. 로봇이 스스로 유지하고, RUN · 이동 지시 · 노드 재시작에도 움직이지 않으며, 켜진 뒤 해제 값을 받기 전에는 움직이지 않습니다 (P-03 · P-06).&lt;br&gt;락 해제 · 잠금은 estop 노드가 /{robot}/set_lock을 직접 부릅니다 (fleet을 거치지 않음, P-08).&lt;br&gt;해제 뒤 작업 모드는 PAUSE라 관리자가 [재시작]을 눌러야 움직입니다 (P-11).&lt;br&gt;하던 교환은 이어서 하지 않습니다. Phony 쪽 바구니는 관리자가 손으로 정리합니다 (체크리스트 P-09)." vertex="1">
          <mxGeometry height="200" width="470" x="1200" y="130" as="geometry" />
        </mxCell>
</root>
    </mxGraphModel>
