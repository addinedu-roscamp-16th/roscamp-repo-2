        <mxCell id="seq5_45" edge="1" parent="1" style="html=1;endArrow=open;endSize=10;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#ffffff;" value="24. /{pinky}/state: ERROR → IDLE (위치: 자기 대기 장소로 다시 설정)">
