        <mxCell id="seq1_41" value="WS: 로봇 위치 · 상태 (UR-11)" style="html=1;endArrow=open;endSize=10;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1">
