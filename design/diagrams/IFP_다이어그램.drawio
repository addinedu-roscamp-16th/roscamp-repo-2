        <mxCell id="flow_60" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" value="&lt;b&gt;Phony 장애 시&lt;/b&gt; → &#39;6-7. 시퀀스: Phony 장애&#39;&lt;br&gt;관리자가 손으로 정리 → 운행 복귀 확인" vertex="1">
