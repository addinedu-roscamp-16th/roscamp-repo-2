        <mxCell id="ship_e_back" edge="1" parent="1" source="ship_er" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.235;entryY=1;entryDx=0;entryDy=0;" target="ship_idle" value="관리자 운행 복귀 확인 (SCR-11) [락 잠김]">
