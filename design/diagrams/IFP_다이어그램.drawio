        <mxCell id="states_mode" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;" value="&lt;b style='font-size:13px;'&gt;운행 모드 — 탭 4-1, D-11&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%;&quot;&gt;&lt;tr style=&quot;background:#eeeeee;&quot;&gt;&lt;th&gt;상태&lt;/th&gt;&lt;th&gt;영문&lt;/th&gt;&lt;th&gt;구분&lt;/th&gt;&lt;th&gt;비고&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;운행 중&lt;/td&gt;&lt;td&gt;RUN&lt;/td&gt;&lt;td style=&quot;background:#ffffff;&quot;&gt;정의됨&lt;/td&gt;&lt;td&gt;OrderBoard.MODE_RUN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;일시 정지&lt;/td&gt;&lt;td&gt;PAUSE&lt;/td&gt;&lt;td style=&quot;background:#ffffff;&quot;&gt;정의됨&lt;/td&gt;&lt;td&gt;작업 중단에 쓸지 추후 논의&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;정지&lt;/td&gt;&lt;td&gt;STOP&lt;/td&gt;&lt;td style=&quot;background:#ffffff;&quot;&gt;정의됨&lt;/td&gt;&lt;td&gt;작업 중단에 쓸지 추후 논의&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
