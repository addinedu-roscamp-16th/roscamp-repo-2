        </mxCell>
        <mxCell id="seq1_r2" edge="1" parent="1" style="html=1;endArrow=open;endSize=10;dashed=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#ffffff;" value="1b. 거절 응답 (주문 기록 없음)">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
