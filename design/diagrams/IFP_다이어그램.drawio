        <mxCell id="flow_64" value="&lt;b&gt;공통 (SR-11)&lt;/b&gt;&lt;br&gt;이동 · 복귀 중 앞 구역이 점유되면 이동 중 대기(WAITING) → 구역이 비면 재개" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
