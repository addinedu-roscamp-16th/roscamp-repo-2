        </mxCell>
        <mxCell id="arm_n4" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" value="&lt;b&gt;«추후 논의»&lt;/b&gt;&lt;br&gt;공유 공간 상태의 인터페이스 표현&lt;br&gt;(ZoneState 사용 · 필드 추가)" vertex="1">
