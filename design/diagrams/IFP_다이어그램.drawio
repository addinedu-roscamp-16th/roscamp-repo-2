        <mxCell id="arm_n1" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" value="&lt;b&gt;규칙 (SR-22, D-05)&lt;/b&gt;&lt;br&gt;각 공유 공간에는 한 번에 한 팔만 들어갑니다.&lt;br&gt;이동 중(ENTERING)도 상대 팔을 막는 점유로 봅니다." vertex="1">
          <mxGeometry height="70" width="330" x="40" y="830" as="geometry" />
        </mxCell>
        <mxCell id="arm_n2" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" value="&lt;b&gt;영역 간 조건&lt;/b&gt;&lt;br&gt;[상품 놓인 곳 선점 없음] · [바구니 선점 없음]은&lt;br&gt;해당 공간 영역이 FREE인지 확인합니다." vertex="1">
          <mxGeometry height="70" width="330" x="390" y="830" as="geometry" />
        </mxCell>
        <mxCell id="arm_n3" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" value="&lt;b&gt;논의 대상 아님&lt;/b&gt;&lt;br&gt;두 팔이 동시에 요청할 때의 우선순위는&lt;br&gt;개발 담당자가 정합니다." vertex="1">
