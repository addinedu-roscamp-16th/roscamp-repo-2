        <mxCell id="s68_55" value="29. 마감 취소 요청 (사유)" style="html=1;endArrow=block;endFill=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
