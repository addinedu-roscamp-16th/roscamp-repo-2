          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow_56" value="&lt;b&gt;Phody 장애 시&lt;/b&gt; → '6-6. 시퀀스: Phody 장애'&lt;br&gt;서비스 일시 정지 → 담은 상품만 일부 출고 강제 처리" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
