        <mxCell id="version-label" value="v2.6 · 2026-11-24" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="-26" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s68_1" value="6-8. 시퀀스 — 마감 (R-08 · R-17 · R-19, OMS-18 · CEN-13)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
