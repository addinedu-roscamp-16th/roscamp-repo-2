          <mxGeometry x="385" y="1584" width="10" height="16" as="geometry" />
        </mxCell>
        <mxCell id="s68_58" value="31. 응답: 마감 취소됨 (&quot;입력한 수량은 재고에 반영되지 않음&quot;)" style="html=1;endArrow=open;endSize=10;dashed=1;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="380" y="1616" as="sourcePoint" />
            <mxPoint x="140" y="1616" as="targetPoint" />
          </mxGeometry>
        </mxCell>
