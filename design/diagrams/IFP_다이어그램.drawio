dgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#d79b00;fontColor=#9a5b00;" edge="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="1854" as="sourcePoint" /><mxPoint x="140" y="1872" as="targetPoint" /><Array as="points"><mxPoint x="180" y="1854" /><mxPoint x="180" y="1872" /></Array></mxGeometry></mxCell><mxCell id="seq5_m49" parent="1" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=70;height=24;fillColor=none;strokeColor=#555555;fontSize=11;fontStyle=1;" vertex="1"><mxGeometry x="70" y="514" width="1280" height="1382" as="geometry" /></mxCell><mxCell id="seq5_m50" parent="1" value="[장애 조치됨]" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1"><mxGeometry x="148" y="514" width="600" height="20" as="geometry" /></mxCell><mxCell id="seq5_m51" parent="1" value="" style="shape=line;html=1;dashed=1;strokeColor=#555555;" vertex="1"><mxGeometry x="70" y="715" width="1280" height="10" as="geometry" /></mxCell><mxCell id="seq5_m52" parent="1" value="[장애 조치 불가]" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1"><mxGeometry x="150" y="722" width="600" height="20" as="geometry" /></mxCell><mxCell id="seq5_m53" parent="1" value="&lt;b&gt;참고&lt;/b&gt;&lt;br&gt;상태 기준: '3. Pode' · '3-1. Pode 장애 예외' · '2. 주문' 탭 (D-10).&lt;br&gt;진행 상황 보고(4~7)는 주문 상태가 바뀔 때(11 · 15 · 27 · 31)마다 같은 방식으로 합니다.&lt;br&gt;장애 Pode의 오류 → 운행 제외(33)는 장애 A · B 모두 같습니다." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1"><mxGeometry x="40" y="1958" width="560" height="70" as="geometry" /></mxCell><mxCell id="seq5_m54" parent="1" value="&lt;b&gt;«추후 논의»&lt;/b&gt;&lt;br&gt;장애 조치 · 조치 불가를 누가 어떤 경로로 판정 · 입력하는지&lt;br&gt;교체 대기 상태(상태 목록에 없음) · 운행 제외 · 수리 완료&lt;br&gt;수동 이동 후 확인에 ConfirmClear를 쓸지 · 이동 밖 상태에서의 장애" style="shape=note;size=14;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1"><mxGeometry x="620" y="1958" width="520" height="70" as="geometry" /></mxCell><mxCell id="version-label" value="v1.7 · 2026-11-17" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40.0" y="-26.0" width="200" height="24" as="geometry" /></mxCell></root>
