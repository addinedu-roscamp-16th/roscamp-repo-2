          <mxGeometry height="24" width="200" x="40" y="-26" as="geometry" />
        </mxCell>
        <mxCell id="arm_pause" parent="1" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="팔 일시 정지 (PAUSED)&lt;br&gt;두 팔 함께 멈춤&lt;br&gt;entry / 관리자 알림&lt;br&gt;락 해제 (팔별, PHD-10) / 팔 힘 풂 · 그리퍼 열림&lt;br&gt;락 잠금 (팔별) / 팔 힘 걺" vertex="1">
          <mxGeometry height="104" width="240" x="1120" y="866" as="geometry" />
        </mxCell>
        <mxCell id="arm_e_pause" edge="1" parent="1" source="arm_ws" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.7467;exitY=1;exitDx=0;exitDy=0;entryX=0.1667;entryY=0;entryDx=0;entryDy=0;" target="arm_pause" value="이상 발생">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arm_e_resume" edge="1" parent="1" source="arm_pause" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="arm_ep_resume" value="재개 (SCR-08 · 12)&lt;br&gt;[모든 팔 락 잠김]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arm_e_p_err" edge="1" parent="1" source="arm_pause" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="arm_err" value="처리 불가">
          <mxGeometry relative="1" x="-0.0964" y="-8" as="geometry">
            <mxPoint x="8" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arm_n6" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;팔 일시 정지 (PHD-08, 11-17)&lt;/b&gt;&lt;br&gt;이상 발생: 두 팔 거리 정지 · 집기 재시도 초과 · 인식 오류(인식 안 됨)&lt;br&gt;재개하면 하던 상품의 집기 대기부터, 공유 공간은 선점 없음(FREE)으로 시작&lt;br&gt;집기 재시도 초과: 바로 놓고 재개 / 못 담음 처리 후 재개 (SCR-12)&lt;br&gt;인식 오류: DB에는 있는데 선반에 없으면 창고에서 작업대 선반으로 갖다 놓고(재고 기록 없음) 재개 / 못 담음 처리 후 재개 (SCR-08). DB 재고 부족 결품은 담기 전에 확인하고 추가 입고로 채움 (&#39;6-2&#39;)&lt;br&gt;운행 모드는 바꾸지 않음 (다른 Pode는 계속)&lt;br&gt;재개는 작업대 아래 &#39;재개&#39; 진입점(○)으로 들어갑니다: 각 팔은 하던 상품의 집기 대기, 공유 공간은 선점 없음에서 시작 (진입점 안쪽 연결선은 생략)" vertex="1">
          <mxGeometry height="140" width="470" x="810" y="976" as="geometry" />
        </mxCell>
        <mxCell id="arm_e_err_back" edge="1" parent="1" source="arm_err" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.86;entryDx=0;entryDy=0;" target="arm_ws" value="장애 처리 완료 (SCR-12)&lt;br&gt;[모든 팔 락 잠김]">
          <mxGeometry relative="1" x="-0.002" as="geometry">
            <Array as="points">
              <mxPoint x="1610" y="914" />
              <mxPoint x="1610" y="696.4" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="arm_ep_resume" parent="1" style="ellipse;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;fontSize=10;" value="재개" vertex="1">
          <mxGeometry height="16" width="16" x="1292" y="792" as="geometry" />
        </mxCell>
        <mxCell id="arm_n_lock" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" value="&lt;b&gt;락 해제 · 잠금 (PHD-10, SCR-20)&lt;/b&gt;&lt;br&gt;팔 일시 정지(PAUSED) · 오류(ERROR) · 서비스 일시 정지(PAUSE) · 비상정지(ESTOP)에서 팔별로 받습니다 (비상정지 중에는 estop 노드가 보냄, &#x27;6-11&#x27;). 락을 풀면 팔 힘이 풀리고 그리퍼가 열려 쥔 상품이 떨어집니다 (R-03, 11-19). 관리자는 떨어진 상품을 작업대 선반에 되돌리고 팔을 손으로 옮길 수 있습니다.&lt;br&gt;요청은 브리지 → fleet → Phody로 가고, fleet이 먼저 · Phody 노드가 한 번 더 확인합니다 (&#x27;6-6&#x27; 12a ~ 12o).&lt;br&gt;한 팔이라도 풀려 있으면 팔을 다시 움직이는 입력(팔 재개 · 장애 처리 완료 · 담기 재개 · 보충 불가 · 못 담음)과 [재시작]을 받지 않습니다.&lt;br&gt;손으로 옮긴 뒤 팔 재개 때는 안전 자세로 돌아간 뒤 하던 상품을 다시 집습니다 (11-19 사용자 결정). 거리 정지 때 그대로 재개하면 두 팔이 다시 부딪힐 수 있기 때문입니다." vertex="1">
          <mxGeometry height="230" width="330" x="1300" y="976" as="geometry" />
        </mxCell>
        <mxCell id="arm_n_force" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" value="&lt;b&gt;시험 모드 강제 입력 경로 (SCR-17, &#39;6-10&#39;)&lt;/b&gt;&lt;br&gt;조건 바꾸기: 집기 실패 · 인식 오류 · 거리 정지 → 이 탭의 원래 규칙대로 팔 일시 정지가 되고 실제로 멈춤&lt;br&gt;상태 바꾸기: 팔 일시 정지(PAUSED) · 오류(ERROR)와 원인 → 실제로 멈추고 보고&lt;br&gt;시험 모드일 때만 받음. 강제 해제 뒤 복귀는 팔 재개 · 장애 처리 완료 등 보통 절차" vertex="1">
          <mxGeometry height="70" width="750" x="40" y="1066" as="geometry" />
        </mxCell>
              <mxCell id="arm_es_reg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fffafa;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;" value="비상정지 (COM-02, &#x27;6-11&#x27;, 11-24) — 모든 상태에 적용" vertex="1">
          <mxGeometry height="200" width="1120" x="40" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="arm_es_any" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" value="모든 상태&lt;br&gt;(작업대 · 팔 일시 정지 · 오류)" vertex="1">
          <mxGeometry height="70" width="190" x="60" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="arm_es_es" parent="1" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="&lt;b&gt;비상정지 (ESTOP)&lt;/b&gt; — 두 팔 함께&lt;br&gt;entry / 동작 멈춤, 서보 힘 유지 (그 자세)&lt;br&gt;해제 신호까지 스스로 유지&lt;br&gt;락 해제 (estop 노드, 팔별) / 서보 힘 풂 · 그리퍼 열림&lt;br&gt;락 잠금 (estop 노드, 팔별) / 서보 힘 걺" vertex="1">
          <mxGeometry height="140" width="390" x="410" y="1276" as="geometry" />
        </mxCell>
        <mxCell id="arm_es_idle" parent="1" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="대기 (IDLE)" vertex="1">
          <mxGeometry height="60" width="180" x="950" y="1315" as="geometry" />
        </mxCell>
        <mxCell id="arm_es_t1" edge="1" parent="1" source="arm_es_any" target="arm_es_es" style="html=1;endArrow=open;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;" value="/safety/estop: 정지&lt;br&gt;(P-02 · P-06)">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="arm_es_t2" edge="1" parent="1" source="arm_es_es" target="arm_es_idle" style="html=1;endArrow=open;endSize=10;fontSize=10;labelBackgroundColor=#ffffff;" value="/safety/estop: 해제 [두 팔 락 잠김]&lt;br&gt;/ 안전 자세에서 시작">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="arm_es_n" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" value="&lt;b&gt;비상정지 (P-01 ~ P-14, &#x27;6-11&#x27;)&lt;/b&gt;&lt;br&gt;관리자 화면 · 태블릿에서 누르면 estop 노드가 /safety/estop을 보냅니다. 모든 로봇이 멈추고 1초 안에 ESTOP을 보고합니다 (P-04).&lt;br&gt;ESTOP은 서비스 일시 정지(PAUSE)와 다릅니다. 로봇이 스스로 유지하고, RUN · 이동 지시 · 노드 재시작에도 움직이지 않으며, 켜진 뒤 해제 값을 받기 전에는 움직이지 않습니다 (P-03 · P-06).&lt;br&gt;락 해제 · 잠금은 estop 노드가 /{robot}/set_lock을 직접 부릅니다 (fleet을 거치지 않음, P-08).&lt;br&gt;해제 뒤 작업 모드는 PAUSE라 관리자가 [재시작]을 눌러야 움직입니다 (P-11).&lt;br&gt;담던 운반 건은 해제 뒤 처음부터 다시 담습니다. 바구니의 상품은 선반에 돌려놓습니다 (P-12 · P-13)." vertex="1">
          <mxGeometry height="200" width="470" x="1180" y="1240" as="geometry" />
        </mxCell>
</root>
    </mxGraphModel>
  </diagram>
