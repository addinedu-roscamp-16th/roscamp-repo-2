      <mxCell id="s_fillst" value="담기 지시 (FillBasket)&lt;br&gt;(주문: 담는 중 FILLING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="692" width="190" height="56" as="geometry" /></mxCell><mxCell id="e6b" value="FillBasket" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_fillst" target="w_fill"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_assign" value="&lt;b&gt;Pode 배정 순서 (FMS)&lt;/b&gt;&lt;br&gt;대기(IDLE) 중인 Pode를 먼저 찾고,&lt;br&gt;없으면 복귀(HOMING) 중인 Pode에 배정" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="295" y="316" width="210" height="70" as="geometry" /></mxCell><mxCell id="e_assign" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="n_assign" target="s_assign"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a_bat" value="배터리&lt;br&gt;35% 이상?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="805" y="1790" width="150" height="84" as="geometry" /></mxCell><mxCell id="a_chg" value="대기 위치로 이동 · 충전&lt;br&gt;(충전 CHARGING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="785" y="1990" width="190" height="56" as="geometry" /></mxCell><mxCell id="e25" value="예" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_bat" target="a_home"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e26" value="아니오" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_bat" target="a_chg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="988" y="1832" /><mxPoint x="988" y="2018" /></Array></mxGeometry></mxCell><mxCell id="e27" value="도킹 완료" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_home" target="a_idle"><mxGeometry relative="1" as="geometry" x="-0.49"><Array as="points"><mxPoint x="772" y="1926" /><mxPoint x="772" y="2130" /></Array><mxPoint x="44" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="e28" value="충전 80% 이상 «가정»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_chg" target="a_idle"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_admin" value="&lt;b&gt;필요 기능 (F-02)&lt;/b&gt;&lt;br&gt;관리자가 Pode 상태를&lt;br&gt;직접 바꿀 수 있어야 함" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="295" y="2096" width="210" height="66" as="geometry" /></mxCell><mxCell id="n_once" value="&lt;b&gt;범위&lt;/b&gt;&lt;br&gt;주문 1건의 흐름. 다음 주문은 처음(주문 등록)부터.&lt;br&gt;메모로 끝나는 가지: 다른 탭에서 이어지거나 추후 논의.&lt;br&gt;Pode의 운행 반복(대기 → 업무 → 대기)은 '3. Pode' 탭" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1015" y="2150" width="220" height="96" as="geometry" /></mxCell><mxCell id="s_cancel" value="보충 불가로 주문 취소&lt;br&gt;(주문: 취소 처리 중 CANCELLING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="1250" width="190" height="56" as="geometry" /></mxCell><mxCell id="e13b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_cancel" target="u_miss"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_partial" value="&lt;b&gt;«추후 논의» (D-04)&lt;/b&gt;&lt;br&gt;보충이 늦어지면 일부 출고&lt;br&gt;(주문: 일부 출고됨 PARTIAL)" style="shape=note;size=14;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="545" y="1340" width="190" height="66" as="geometry" /></mxCell><mxCell id="e_partial" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="n_partial" target="s_cancel"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_f_pod" value="&lt;b&gt;장애 시&lt;/b&gt; → '3-1. Pode 장애 예외' 탭&lt;br&gt;(이동 중. 출고 구역 이동도 같음)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1015" y="410" width="210" height="50" as="geometry" /></mxCell><mxCell id="e_f_pod" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="n_f_pod" target="a_move"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_f_arm" value="&lt;b&gt;장애 시&lt;/b&gt; → '4-1. Phody 장애 예외' 탭&lt;br&gt;(상품 인식 · 담기 중)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1015" y="616" width="210" height="50" as="geometry" /></mxCell><mxCell id="e_f_arm" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="n_f_arm" target="w_fill"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_f_ship" value="&lt;b&gt;장애 시&lt;/b&gt; → '5-1. Phony 장애 예외' 탭&lt;br&gt;(바구니 교환 중)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1265" y="1172" width="190" height="50" as="geometry" /></mxCell><mxCell id="n_cancel" value="&lt;b&gt;주문 취소&lt;/b&gt;&lt;br&gt;사용자가 취소를 요청하면&lt;br&gt;→ '2. 주문' · '6-4' 탭" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="200" height="60" as="geometry" /></mxCell><mxCell id="e_batt" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="n_batt" target="a_bat"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_f_ship" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#666666;" edge="1" parent="1" source="n_f_ship" target="sh_take"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="version-label" value="v1.7 · 2026-11-17" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40.0" y="-16.0" width="200" height="24" as="geometry" /></mxCell></root>
    </mxGraphModel>
