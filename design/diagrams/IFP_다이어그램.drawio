        <mxCell id="HJ5xonUU95T0abzoQFkI-2" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fillColor=#f8f9fa;strokeColor=#555555;fontSize=13;" value="운행 중" vertex="1">
