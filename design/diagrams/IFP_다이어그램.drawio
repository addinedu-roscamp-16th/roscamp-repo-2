          <mxGeometry x="375" y="1530" width="10" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s68_61" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=70;height=24;fillColor=none;strokeColor=#555555;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="582" width="860" height="1102" as="geometry" />
        </mxCell>
        <mxCell id="s68_62" value="[마감 확정까지 진행 (모든 상품을 셈 · 차이마다 사유 있음)]" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="148" y="582" width="770" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s68_63" value="" style="shape=line;direction=south;html=1;dashed=1;strokeColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="135" y="110" width="10" height="1598" as="geometry" />
        </mxCell>
        <mxCell id="s68_64" value="" style="shape=line;direction=south;html=1;dashed=1;strokeColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="375" y="110" width="10" height="1598" as="geometry" />
        </mxCell>
        <mxCell id="s68_65" value="" style="shape=line;direction=south;html=1;dashed=1;strokeColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="615" y="110" width="10" height="1598" as="geometry" />
        </mxCell>
        <mxCell id="s68_66" value="" style="shape=line;direction=south;html=1;dashed=1;strokeColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="855" y="110" width="10" height="1598" as="geometry" />
        </mxCell>
        <mxCell id="s68_67" value="&lt;b&gt;판단 (R-08 · R-17 · R-19, 마감 DB 토의 11-19)&lt;/b&gt;&lt;br&gt;재고는 입고 · 반출 · 출고 차감 · 마감 조정 · 수시 조정의 결과로만 바뀝니다 (직접 수정 없음).&lt;br&gt;담는 중 · 운반 중 상품 때문에 생기는 가짜 차이를 막으려고 진행 중 운반 건이 0일 때 셉니다. 장부 수량은 확정 순간에 찍습니다.&lt;br&gt;마감 시작 때 이미 시작된 나뉜 주문은 남은 운반 건까지 끝내고 실사를 엽니다 (주문 하나가 마감 앞뒤로 갈라지지 않게).&lt;br&gt;마감 뒤 거절은 새 상태를 만들지 않고 접수됨 → 취소됨 (STOCK_RECHECK)으로 그립니다 (&#39;2. 주문&#39; 탭).&lt;br&gt;마감 중 장애 Pode의 주문을 접수됨으로 되돌리는 경우(&#39;6-5&#39; 3번)도 배정 보류 대상입니다.&lt;br&gt;central은 DB가 없으므로 보류 · 재개는 &quot;지금 상태 + 주문판 목록&quot;을 다시 보내는 방식이고, 반영 답이 오면 시각을 적습니다." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1738" width="720" height="135" as="geometry" />
        </mxCell>
        <mxCell id="s68_68" value="&lt;b&gt;수시 조정 (마감 밖, R-08 · R-17 ③, 재고 화면 6번 탭 장면 7)&lt;/b&gt;&lt;br&gt;상품 하나만 세어 맞춥니다 (기록 종류 SPOT_ADJUST, 창고 전체를 셈).&lt;br&gt;받지 않는 경우: 마감 중 · 그 상품을 담는 진행 중 운반 건이 있고 담은 수를 모를 때.&lt;br&gt;담기 일시 중지 때 담은 수를 알리는 인터페이스가 생기면 받습니다.&lt;br&gt;받으면 장부 수량 = 그 순간 재고, 바구니에 든 수를 따로 남깁니다." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="780" y="1738" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s68_69" value="&lt;b&gt;범례 (UML 시퀀스)&lt;/b&gt;&lt;br&gt;실선 + 채운 화살촉: 동기 호출 (서비스 · HTTP 요청) — 응답이 올 때까지 기다림&lt;br&gt;관리자 입력 (화면 → 주문 관리, 예: 일시 정지 · 강제 처리 입력): 비동기 + 결과는 WS로 받음&lt;br&gt;실선 + 열린 화살촉: 비동기 메시지 (토픽 · 액션 목표 · 피드백 · 보고 · 알림) — 기다리지 않음&lt;br&gt;점선 + 열린 화살촉: 응답 (서비스 응답 · HTTP 응답 · 액션 결과)&lt;br&gt;서비스 = 요청 · 응답 (실선 + 채운 화살촉, 점선 응답) · 토픽 = 발행 · 구독 (실선 + 열린 화살촉, 비동기)&lt;br&gt;흰 세로 막대 (실행 박스): 동기 호출을 받아 응답할 때까지 처리하는 구간 (&#39;6-1-1&#39; · &#39;6-4&#39;)&lt;br&gt;막대 위에 겹친 짧은 막대: 처리 중 자기 메시지 (내부 처리)&lt;br&gt;alt / opt / loop: 조합 단편 · 녹색 머리: 웹 서비스 영역&lt;br&gt;인터페이스 정의 예정인 요청 · 보고는 비동기로 표시 (서비스로 정해지면 응답 · 막대 추가)&lt;br&gt;메시지의 [ ] = 그 메시지를 보내는 조건 (팀 약속)&lt;br&gt;번호 뒤 글자(예: 22a) = 그 사이에 끼워 넣은 단계 (동시 실행 아님)&lt;br&gt;ref의 번호 범위(예: 6-8 5 ~ 15)는 그 탭의 메시지 구간을 가리킴 (팀 약속)" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1893" width="560" height="260" as="geometry" />
        </mxCell>
        <mxCell id="s68_70" value="&lt;b&gt;인터페이스 정의 예정&lt;/b&gt;&lt;br&gt;5 · 6 · 8 · 9 배정 보류 · 반영 답, 23 · 24 · 26 · 27 · 32 배정 재개 · 반영 답 (웹 ↔ central, 마감 DB 토의 6장)&lt;br&gt;central 재시작 때 웹에 보류 여부를 먼저 묻기&lt;br&gt;WS 메시지: 마감 상태 · 주문 취소 안내 · 재고 부족 알림" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="620" y="1893" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s68_60" value="ref" style="shape=umlFrame;whiteSpace=wrap;html=1;width=44;height=24;fillColor=none;strokeColor=#555555;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1632" width="620" height="44" as="geometry" />
        </mxCell>
        <mxCell id="s68_60t" value="&lt;b&gt;32. 배정 재개 — 6-8 23 ~ 28과 같음&lt;/b&gt;&lt;br&gt;release 전달 → 반영 답 → release_acked_at 기록 (대기 주문 재확인 없음)" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="345" y="1636" width="570" height="36" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
