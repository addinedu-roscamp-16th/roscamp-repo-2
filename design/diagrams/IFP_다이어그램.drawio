        <mxCell id="states_order" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;" value="&lt;b style='font-size:13px;'&gt;주문 — 탭 2, D-04 (전체 «검토 중», 주문 관리가 DB에 기록)&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;3&quot; style=&quot;border-collapse:collapse;font-size:11px;width:100%;&quot;&gt;&lt;tr style=&quot;background:#eeeeee;&quot;&gt;&lt;th&gt;상태&lt;/th&gt;&lt;th&gt;영문&lt;/th&gt;&lt;th&gt;구분&lt;/th&gt;&lt;th&gt;비고&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;접수됨&lt;/td&gt;&lt;td&gt;RECEIVED&lt;/td&gt;&lt;td style=&quot;background:#ffe6cc;&quot;&gt;검토 중&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;배정됨&lt;/td&gt;&lt;td&gt;ASSIGNED&lt;/td&gt;&lt;td style=&quot;background:#ffe6cc;&quot;&gt;검토 중&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;담는 중&lt;/td&gt;&lt;td&gt;FILLING&lt;/td&gt;&lt;td style=&quot;background:#ffe6cc;&quot;&gt;검토 중&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;운반 중&lt;/td&gt;&lt;td&gt;TRANSPORTING&lt;/td&gt;&lt;td style=&quot;background:#ffe6cc;&quot;&gt;검토 중&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;출고됨&lt;/td&gt;&lt;td&gt;SHIPPED&lt;/td&gt;&lt;td style=&quot;background:#ffffff;&quot;&gt;정의됨&lt;/td&gt;&lt;td&gt;취소 불가 · SR-03 '출고 완료'&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;일부 출고됨&lt;/td&gt;&lt;td&gt;PARTIAL&lt;/td&gt;&lt;td style=&quot;background:#ffffff;&quot;&gt;정의됨&lt;/td&gt;&lt;td&gt;취소 불가(검토 중)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;결품 발생&lt;/td&gt;&lt;td&gt;HELD&lt;/td&gt;&lt;td style=&quot;background:#ffffff;&quot;&gt;정의됨&lt;/td&gt;&lt;td&gt;사유는 detail(결품, D-02 1차)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;주문 처리 보류&lt;/td&gt;&lt;td&gt;HELD&lt;/td&gt;&lt;td style=&quot;background:#ffffff;&quot;&gt;정의됨&lt;/td&gt;&lt;td&gt;사유는 detail(Phody · Pode 장애)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;주문 처리 중단&lt;/td&gt;&lt;td&gt;ABORTED&lt;/td&gt;&lt;td style=&quot;background:#ffe6cc;&quot;&gt;검토 중&lt;/td&gt;&lt;td&gt;관리자 수동 처리 