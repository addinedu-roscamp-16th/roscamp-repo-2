        <mxCell id="HJ5xonUU95T0abzoQFkI-26" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=6;" value="&lt;b&gt;충전 완료 기준 (D-03 5차)&lt;/b&gt;&lt;br&gt;80% 이상 «가정»&lt;br&gt;시험은 강제 입력(충전 끝내기, SCR-17)으로" vertex="1">
